{
  "model": "opus",
  "theme": "dark",
  "env": {
    "CLAUDE_CODE_PLUGIN_PREFER_HTTPS": "1",
    "IMPECCABLE_NO_TELEMETRY": "1"
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/config.vdf)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh repo delete *)",
      "Bash(rm -rf *)",
      "mcp__godot-mcp-toolkit__execute_code",
      "mcp__godot-mcp-toolkit__node_call_method",
      "mcp__godot-mcp-toolkit__script_write",
      "mcp__rea__capture_process_scenario",
      "mcp__rea__capture_electron_scenario",
      "mcp__rea__capture_browser_scenario",
      "mcp__rea__capture_native_ui_scenario",
      "mcp__rea__observe_native_calls",
      "mcp__rea__observe_web_execution",
      "mcp__rea__instrument_with_frida",
      "mcp__rea__start_frida_session",
      "mcp__rea__load_frida_script",
      "mcp__rea__resume_frida_session",
      "mcp__rea__close_frida_session",
      "mcp__rea__start_gdb_session",
      "mcp__rea__gdb_console",
      "mcp__rea__close_gdb_session",
      "mcp__rea__start_rizin_debug_session",
      "mcp__rea__rizin_debug_command",
      "mcp__rea__close_rizin_debug_session",
      "mcp__rea__execute_rizin_command",
      "mcp__rea__cutter_command",
      "mcp__rea__install_adb_package",
      "mcp__rea__uninstall_adb_package",
      "mcp__rea__push_adb_file",
      "mcp__rea__start_adb_app",
      "mcp__rea__start_adb_activity",
      "mcp__rea__stop_adb_app"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  }
}
