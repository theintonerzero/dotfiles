{
  "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "editor.rulers": [
    100
  ],
  "editor.formatOnSave": true,
  "editor.selectionClipboard": false,
  "workbench.colorTheme": "Kanagawa Dragon",
  "[gdscript]": {
    "editor.insertSpaces": false,
    "editor.tabSize": 4
  },
  "godotTools.lsp.serverPort": 6005,
  "git.autofetch": true,
  "claudeCode.preferredLocation": "panel",
  "editor.lineNumbers": "relative",
  "dotnet.server.useOmnisharp": false,
  "vim.leader": "<space>",
  "vim.useSystemClipboard": true,
  "vim.ignorecase": true,
  "vim.smartcase": true,
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.surround": true,
  "vim.timeout": 500,
  "vim.highlightedyank.enable": true,
  "vim.insertModeKeyBindings": [
    {"before": ["j", "j"], "after": ["<Esc>"]},
    {"before": ["j", "k"], "after": ["<Esc>"]}
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {"before": ["<leader>", "w"], "commands": ["workbench.action.files.save"]},
    {"before": ["<C-s>"], "commands": ["workbench.action.files.save"]},
    {"before": ["<leader>", "q"], "commands": ["workbench.action.closeEditorsAndGroup"]},
    {"before": ["<leader>", "Q"], "commands": ["workbench.action.closeWindow"]},
    {"before": ["<leader>", "n"], "commands": ["workbench.action.files.newUntitledFile"]},
    {"before": ["<leader>", "h"], "commands": ["workbench.action.openWalkthrough"]},
    {"before": ["|"], "commands": ["workbench.action.splitEditorRight"]},
    {"before": ["\\"], "commands": ["workbench.action.splitEditorDown"]},
    {"before": ["<C-h>"], "commands": ["workbench.action.navigateLeft"]},
    {"before": ["<C-j>"], "commands": ["workbench.action.navigateDown"]},
    {"before": ["<C-k>"], "commands": ["workbench.action.navigateUp"]},
    {"before": ["<C-l>"], "commands": ["workbench.action.navigateRight"]},
    {"before": ["<leader>", "c"], "commands": ["workbench.action.closeActiveEditor"]},
    {"before": ["<leader>", "C"], "commands": ["workbench.action.revertAndCloseActiveEditor"]},
    {"before": ["]", "b"], "commands": ["workbench.action.nextEditorInGroup"]},
    {"before": ["[", "b"], "commands": ["workbench.action.previousEditorInGroup"]},
    {"before": ["<leader>", "b", "b"], "commands": ["workbench.action.showAllEditors"]},
    {"before": ["<leader>", "b", "c"], "commands": ["workbench.action.closeOtherEditors"]},
    {"before": ["<leader>", "b", "C"], "commands": ["workbench.action.closeAllEditors"]},
    {"before": ["<leader>", "b", "l"], "commands": ["workbench.action.closeEditorsToTheLeft"]},
    {"before": ["<leader>", "b", "r"], "commands": ["workbench.action.closeEditorsToTheRight"]},
    {"before": ["<leader>", "b", "p"], "commands": ["workbench.action.openPreviousRecentlyUsedEditorInGroup"]},
    {"before": ["<leader>", "e"], "commands": ["workbench.action.toggleSidebarVisibility"]},
    {"before": ["<leader>", "o"], "commands": ["workbench.files.action.focusFilesExplorer"]},
    {"before": ["<leader>", "/"], "commands": ["editor.action.commentLine"]},
    {"before": ["<leader>", "t", "f"], "commands": ["workbench.action.terminal.toggleTerminal"]},
    {"before": ["<leader>", "t", "h"], "commands": ["workbench.action.terminal.toggleTerminal"]},
    {"before": ["<leader>", "t", "v"], "commands": ["workbench.action.createTerminalEditorSide"]},
    {"before": ["<leader>", "f", "f"], "commands": ["workbench.action.quickOpen"]},
    {"before": ["<leader>", "f", "F"], "commands": ["workbench.action.quickOpen"]},
    {"before": ["<leader>", "f", "s"], "commands": ["workbench.action.quickOpen"]},
    {"before": ["<leader>", "f", "w"], "commands": ["workbench.action.findInFiles"]},
    {"before": ["<leader>", "f", "W"], "commands": ["workbench.action.findInFiles"]},
    {"before": ["<leader>", "f", "b"], "commands": ["workbench.action.showAllEditors"]},
    {"before": ["<leader>", "f", "o"], "commands": ["workbench.action.showAllEditorsByMostRecentlyUsed"]},
    {"before": ["<leader>", "f", "p"], "commands": ["workbench.action.openRecent"]},
    {"before": ["<leader>", "f", "C"], "commands": ["workbench.action.showCommands"]},
    {"before": ["<leader>", "f", "k"], "commands": ["workbench.action.openGlobalKeybindings"]},
    {"before": ["<leader>", "f", "t"], "commands": ["workbench.action.selectTheme"]},
    {"before": ["<leader>", "f", "n"], "commands": ["notifications.showList"]},
    {"before": ["K"], "commands": ["editor.action.showHover"]},
    {"before": ["g", "l"], "commands": ["editor.action.showHover"]},
    {"before": ["g", "D"], "commands": ["editor.action.revealDeclaration"]},
    {"before": ["g", "I"], "commands": ["editor.action.goToImplementation"]},
    {"before": ["g", "y"], "commands": ["editor.action.goToTypeDefinition"]},
    {"before": ["g", "r", "r"], "commands": ["editor.action.goToReferences"]},
    {"before": ["g", "r", "n"], "commands": ["editor.action.rename"]},
    {"before": ["g", "r", "a"], "commands": ["editor.action.quickFix"]},
    {"before": ["g", "r", "i"], "commands": ["editor.action.goToImplementation"]},
    {"before": ["]", "d"], "commands": ["editor.action.marker.next"]},
    {"before": ["[", "d"], "commands": ["editor.action.marker.prev"]},
    {"before": ["<leader>", "l", "a"], "commands": ["editor.action.quickFix"]},
    {"before": ["<leader>", "l", "A"], "commands": ["editor.action.sourceAction"]},
    {"before": ["<leader>", "l", "d"], "commands": ["editor.action.showHover"]},
    {"before": ["<leader>", "l", "D"], "commands": ["workbench.actions.view.problems"]},
    {"before": ["<leader>", "l", "f"], "commands": ["editor.action.formatDocument"]},
    {"before": ["<leader>", "l", "h"], "commands": ["editor.action.triggerParameterHints"]},
    {"before": ["<leader>", "l", "r"], "commands": ["editor.action.rename"]},
    {"before": ["<leader>", "l", "R"], "commands": ["editor.action.goToReferences"]},
    {"before": ["<leader>", "l", "s"], "commands": ["workbench.action.gotoSymbol"]},
    {"before": ["<leader>", "l", "S"], "commands": ["outline.focus"]},
    {"before": ["<leader>", "l", "G"], "commands": ["workbench.action.showAllSymbols"]},
    {"before": ["<leader>", "x", "q"], "commands": ["workbench.actions.view.problems"]},
    {"before": ["]", "g"], "commands": ["workbench.action.editor.nextChange"]},
    {"before": ["[", "g"], "commands": ["workbench.action.editor.previousChange"]},
    {"before": ["<leader>", "g", "g"], "commands": ["workbench.view.scm"]},
    {"before": ["<leader>", "g", "t"], "commands": ["workbench.view.scm"]},
    {"before": ["<leader>", "g", "b"], "commands": ["git.checkout"]},
    {"before": ["<leader>", "g", "d"], "commands": ["git.openChange"]},
    {"before": ["<leader>", "g", "p"], "commands": ["editor.action.dirtydiff.next"]},
    {"before": ["<leader>", "g", "s"], "commands": ["git.stageSelectedRanges"]},
    {"before": ["<leader>", "g", "S"], "commands": ["git.stage"]},
    {"before": ["<leader>", "g", "r"], "commands": ["git.revertSelectedRanges"]},
    {"before": ["<leader>", "d", "b"], "commands": ["editor.debug.action.toggleBreakpoint"]},
    {"before": ["<leader>", "d", "B"], "commands": ["workbench.debug.viewlet.action.removeAllBreakpoints"]},
    {"before": ["<leader>", "d", "c"], "commands": ["workbench.action.debug.continue"]},
    {"before": ["<leader>", "d", "i"], "commands": ["workbench.action.debug.stepInto"]},
    {"before": ["<leader>", "d", "o"], "commands": ["workbench.action.debug.stepOver"]},
    {"before": ["<leader>", "d", "O"], "commands": ["workbench.action.debug.stepOut"]},
    {"before": ["<leader>", "d", "p"], "commands": ["workbench.action.debug.pause"]},
    {"before": ["<leader>", "d", "q"], "commands": ["workbench.action.debug.stop"]},
    {"before": ["<leader>", "d", "Q"], "commands": ["workbench.action.debug.stop"]},
    {"before": ["<leader>", "d", "r"], "commands": ["workbench.action.debug.restart"]},
    {"before": ["<leader>", "d", "R"], "commands": ["workbench.debug.action.toggleRepl"]},
    {"before": ["<leader>", "d", "s"], "commands": ["editor.debug.action.runToCursor"]},
    {"before": ["<leader>", "d", "h"], "commands": ["editor.debug.action.showDebugHover"]},
    {"before": ["<leader>", "d", "u"], "commands": ["workbench.view.debug"]},
    {"before": ["<leader>", "u", "w"], "commands": ["editor.action.toggleWordWrap"]}
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {"before": ["<C-s>"], "commands": ["workbench.action.files.save"]},
    {"before": ["<leader>", "/"], "commands": ["editor.action.commentLine"]},
    {"before": ["<tab>"], "commands": ["editor.action.indentLines"]},
    {"before": ["<S-tab>"], "commands": ["editor.action.outdentLines"]},
    {"before": ["<leader>", "l", "a"], "commands": ["editor.action.quickFix"]},
    {"before": ["<leader>", "l", "f"], "commands": ["editor.action.formatSelection"]},
    {"before": ["<leader>", "g", "s"], "commands": ["git.stageSelectedRanges"]},
    {"before": ["<leader>", "g", "r"], "commands": ["git.revertSelectedRanges"]}
  ]
}
