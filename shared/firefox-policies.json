{
  "policies": {
    "ExtensionSettings": {
      "uBlock0@raymondhill.net": {
        "installation_mode": "normal_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi"
      }
    },
    "3rdparty": {
      "Extensions": {
        "uBlock0@raymondhill.net": {
          "toOverwrite": {
            "filterLists": [
              "user-filters",
              "ublock-filters",
              "ublock-badware",
              "ublock-privacy",
              "ublock-unbreak",
              "ublock-quick-fixes",
              "easylist",
              "easyprivacy",
              "urlhaus-1",
              "plowe-0",
              "adguard-spyware-url",
              "fanboy-cookiemonster",
              "ublock-cookies-easylist"
            ]
          }
        }
      }
    },
    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "DisableRemoteImprovements": true,
    "EnableTrackingProtection": {
      "Value": true,
      "Category": "strict"
    },
    "DNSOverHTTPS": {
      "Enabled": true,
      "Fallback": true,
      "Locked": false
    },
    "NetworkPrediction": false,
    "HttpsOnlyMode": "enabled",
    "Permissions": {
      "Notifications": { "BlockNewRequests": true, "Locked": false },
      "Location": { "BlockNewRequests": true, "Locked": false }
    },
    "PasswordManagerEnabled": false,
    "AutofillAddressEnabled": false,
    "AutofillCreditCardEnabled": false,
    "SearchEngines": {
      "Default": "DuckDuckGo"
    },
    "SearchSuggestEnabled": false,
    "FirefoxHome": {
      "SponsoredTopSites": false,
      "SponsoredStories": false,
      "Locked": false
    },
    "FirefoxSuggest": {
      "WebSuggestions": false,
      "SponsoredSuggestions": false,
      "OnlineEnabled": false,
      "Locked": false
    },
    "UserMessaging": {
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "UrlbarInterventions": false,
      "MoreFromMozilla": false,
      "FirefoxLabs": false,
      "SkipOnboarding": true,
      "Locked": false
    },
    "NoDefaultBookmarks": true,
    "Homepage": {
      "URL": "about:home",
      "StartPage": "previous-session",
      "Locked": false
    },
    "Preferences": {
      "browser.newtabpage.pinned": { "Value": "[]", "Status": "default", "Type": "string" },
      "privacy.globalprivacycontrol.enabled": { "Value": true, "Status": "locked", "Type": "boolean" },
      "network.http.referer.XOriginTrimmingPolicy": { "Value": 2, "Status": "default", "Type": "number" },
      "media.peerconnection.ice.default_address_only": { "Value": true, "Status": "default", "Type": "boolean" },
      "network.IDN_show_punycode": { "Value": true, "Status": "locked", "Type": "boolean" },
      "pdfjs.enableScripting": { "Value": false, "Status": "default", "Type": "boolean" },
      "network.prefetch-next": { "Value": false, "Status": "default", "Type": "boolean" },
      "browser.urlbar.speculativeConnect.enabled": { "Value": false, "Status": "default", "Type": "boolean" },
      "browser.places.speculativeConnect.enabled": { "Value": false, "Status": "default", "Type": "boolean" }
    },
    "AIControls": {
      "Default": { "Value": "blocked", "Locked": false },
      "Translations": { "Value": "available", "Locked": false }
    }
  }
}
