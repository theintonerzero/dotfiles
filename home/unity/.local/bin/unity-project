#!/usr/bin/env bash
# unity-project [path]: sets up a unity project (the one at path, or here: this folder, a parent, or
# ./game) for claude and neovim:
# unity's pipeline package, which the unity cli and claude's unity mcp server drive the editor through,
# the neovim ide package, which opens scripts in neovim and writes the .sln its c# server reads, and
# vulkan alone for its linux editor and builds; on macos unity opens scripts in vscodium, and the
# project still gets both, so it's ready for linux too
set -euo pipefail
dotfiles=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../..
# shellcheck source-path=SCRIPTDIR source=../../../../lib.sh
source "$dotfiles/lib.sh"
# shellcheck source-path=SCRIPTDIR source=../../../../shared/platform.sh
source "$dotfiles/shared/platform.sh"
# shellcheck source-path=SCRIPTDIR source=../../../../shared/unity.sh
source "$dotfiles/shared/unity.sh"

# the neovim package at the commit these dotfiles were checked against, so a new project gets the same
# code, not whatever the repo has since; move it on by hand
neovim_pkg=com.walcht.ide.neovim
neovim_url=https://github.com/walcht/com.walcht.ide.neovim.git#54fb26c29f5fc35cab1cb5f7be49e326813b251e

# is_project <dir>: a unity project has its editor version in ProjectSettings and its packages listed
is_project() { [[ -f $1/ProjectSettings/ProjectVersion.txt && -f $1/Packages/manifest.json ]]; }

project="" dir=$PWD
if (($#)); then
  is_project "$1" || die "$1 isn't a unity project (ProjectSettings/ProjectVersion.txt)"
  dir=$(cd "$1" && pwd)
fi
while :; do
  if is_project "$dir"; then project=$dir; break; fi
  [[ $dir != / ]] || break
  dir=$(dirname "$dir")
done
if [[ -z $project ]] && ((!$#)) && is_project "$PWD/game"; then project=$PWD/game; fi
[[ -n $project ]] || die "no unity project (ProjectSettings/ProjectVersion.txt) here, above here, or in ./game"
have unity || die "no unity cli: run dot install"

manifest=$project/Packages/manifest.json
jq -e . "$manifest" >/dev/null 2>&1 || die "$manifest isn't valid json"

say "installing unity's pipeline package in $project"
unity pipeline install --project-path "$project" --non-interactive

if jq -e --arg p "$neovim_pkg" '.dependencies[$p]' "$manifest" >/dev/null; then
  say "the neovim ide package is already in $project"
else
  say "adding the neovim ide package to $project"
  if jq --arg p "$neovim_pkg" --arg u "$neovim_url" '.dependencies[$p] = $u' "$manifest" >"$manifest.new"; then
    mv -f "$manifest.new" "$manifest"
  else
    rm -f "$manifest.new"
    die "couldn't add the neovim ide package to $manifest"
  fi
fi

# the linux editor and builds on vulkan; unity's script editor as this os has it (neovim in the default
# terminal, or vscodium on macos), unless unity is open, which leaves a todo
unity_vulkan "$project"
unity_editor
todo_print
echo "Open it with: unity open \"$project\""
