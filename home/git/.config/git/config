# git: delta for diffs, commits signed with your ssh key, https logins in gnome's keyring, and your name
# and email from ~/.config/git/local, which dot install writes; what tools add with --global goes in
# ~/.gitconfig
[core]
	editor = nvim
	pager = delta
	autocrlf = false
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = ansi
[init]
	defaultBranch = main
[pull]
	ff = only
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[diff]
	colorMoved = default
	algorithm = histogram
[user]
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
# https passwords and tokens, such as gitlab's, kept in gnome's keyring; github and its gists sign in
# through gh alone, as each one's empty helper clears the keyring's, so gh's token never lands in it
[credential]
	helper = libsecret
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[include]
	path = ~/.config/git/local
