# git: delta for diffs, the newest branches and tags first, rebases that stash, squash fixups and
# move stacked branches, commits signed with your ssh key, https logins where this os keeps them, and
# your name and email from ~/.config/git/local, which dot install writes; what tools add with
# --global goes in ~/.gitconfig
[core]
	editor = nvim
	pager = delta
	autocrlf = false
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = ansi
[init]
	defaultBranch = main
[pull]
	ff = only
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[diff]
	colorMoved = default
	algorithm = histogram
[user]
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
	verbose = true
[tag]
	gpgsign = true
	sort = -version:refname
[branch]
	sort = -committerdate
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[help]
	autocorrect = prompt
# https passwords and tokens, such as gitlab's, kept where ~/.config/git/credential says, which is each
# os's own file: gnome's keyring, or macos's keychain; github and its gists sign in through gh alone, as
# each one's empty helper clears that one, so gh's token never lands in it
[include]
	path = ~/.config/git/credential
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[include]
	path = ~/.config/git/local
