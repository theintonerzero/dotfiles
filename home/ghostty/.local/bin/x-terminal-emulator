#!/usr/bin/env bash
# x-terminal-emulator [-T title] [-e command [arg]...]: debian's name for "the terminal", which apps such
# as unity hub run when they know no terminal of their own; it opens the default one (ghostty, from
# xdg-terminals.list) through xdg-terminal-exec
set -euo pipefail

args=()
while (($#)); do
  case $1 in
    -T | --title)
      (($# >= 2)) || { shift; break; }
      args+=("--title=$2")
      shift 2
      ;;
    --title=*) args+=("--title=${1#--title=}") && shift ;;
    --working-directory=*) args+=("--dir=${1#--working-directory=}") && shift ;;
    --hold) args+=(--hold) && shift ;;
    -e | -x | --command | --)
      shift
      break
      ;;
    -*) shift ;; # another terminal's option, which ghostty has no use for
    *) break ;;
  esac
done
# a command given as one string, as `-e "bash -c '…'"` from apps written for xterm, runs through sh
if (($# == 1)) && [[ $1 == *[[:space:]]* ]]; then set -- sh -c "$1"; fi
exec xdg-terminal-exec "${args[@]}" -- "$@"
